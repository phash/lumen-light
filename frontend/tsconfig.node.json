  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "eslint.config.js", "playwright.config.ts", "playwright.golden.config.ts", "vite.golden.config.ts", "golden-e2e"]
}
