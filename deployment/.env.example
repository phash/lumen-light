# Kopiere zu .env und passe Werte an (Secrets via `openssl rand -hex 24`).
# Wird von deployment/docker-compose.prod.yml gelesen. chmod 600 (deploy.sh
# und backup.sh erzwingen das). Format: KEY=WERT, optional "..." oder '...',
# keine Expansion — `$` nur in '...' (sonst Abbruch, siehe deployment/lib/env.sh).
# Topologie: alles unter lumen.mr-development.de (SPA, /api, /auth, /lumen-images).

# --- PostgreSQL (Lumen-DB; Keycloak nutzt separate DB 'keycloak' derselben Instanz) ---
# POSTGRES_USER ist der Superuser — NUR fuer Init, Admin und Backup (pg_dump).
POSTGRES_USER=lumen
POSTGRES_PASSWORD=bitte-aendern-strong-password
POSTGRES_DB=lumen
# Least-Privilege-Rollen (kein Superuser): lumen_app = Owner der App-DB (API +
# Alembic), keycloak = Owner der DB 'keycloak'. NUR hex (openssl rand -hex 24),
# das API-Passwort steht in der DATABASE_URL. Leer = deploy.sh generiert sie
# beim naechsten Lauf und traegt sie hier ein. Rotation: Wert aendern +
# deploy.sh (setzt ALTER ROLE ... PASSWORD idempotent).
LUMEN_DB_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# --- Keycloak (self-contained, unter /auth derselben Domain) ---
# Master-Admin fuer kcadm (deploy.sh). Nur beim Erst-Install als
# KC_BOOTSTRAP_ADMIN_* an den Container gereicht, sonst nicht in dessen Env.
# KC_BOOTSTRAP_ADMIN_* selbst NICHT hier eintragen.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=bitte-aendern-strong-password
# WICHTIG: relativen Pfad /auth mit angeben — sonst baut Keycloak den Issuer
# OHNE /auth (https://.../realms/lumen) und der Backend-iss-Check schlaegt fehl.
KC_HOSTNAME=https://lumen.mr-development.de/auth
# Issuer = KC_HOSTNAME + /realms/lumen — muss exakt dem Token-iss-Claim entsprechen.
KEYCLOAK_ISSUER=https://lumen.mr-development.de/auth/realms/lumen
KEYCLOAK_AUDIENCE=lumen-api
JWK_CACHE_SECONDS=600
# Service-Account fuer DELETE /me (loescht auch den KC-User): Client 'lumen-admin'
# (confidential, nur realm-management/manage-users). deploy.sh legt ihn idempotent
# an und traegt ID + Secret hier ein, wenn leer. Leer = KC-Account bliebe stehen.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Interner KC-Server-Root fuer Admin-REST-Calls der API (/auth/admin/* ist
# oeffentlich gesperrt). Default in docker-compose.prod.yml.
KEYCLOAK_INTERNAL_URL=http://lumen-keycloak:8080/auth

# --- Garage (S3-Storage, lumen-garage, nur im lumen-internal-Netz) ---
# Cluster-RPC-Secret + Admin-API-Token: openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# Intern fuer head/copy/delete (API <-> Garage), oeffentlich fuer Pre-Signed-Browser-URLs.
GARAGE_S3_ENDPOINT=http://lumen-garage:3900
GARAGE_S3_PUBLIC_ENDPOINT=https://lumen.mr-development.de
GARAGE_S3_REGION=garage
GARAGE_S3_BUCKET=lumen-images
# Least-privilege-Key der API (read+write nur auf diesem Bucket, kein owner).
# lumen-garage-init importiert ihn. Garage-Format:
#   KEY_ID = "GK" + openssl rand -hex 12     SECRET = openssl rand -hex 32
GARAGE_S3_ACCESS_KEY_ID=GK000000000000000000000000
GARAGE_S3_SECRET_ACCESS_KEY=

# --- Nur fuer die einmalige Migration MinIO -> Garage (deploy.sh) ---
# Solange der Alt-Container lumen-minio laeuft, kopiert deploy.sh dessen
# Bucket nach Garage. Danach koennen die beiden Zeilen weg.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Backup (deployment/backup.sh) ---
# Passphrase-Datei fuer die gpg-Verschluesselung (chmod 600, NICHT im Repo).
# Leer = Backups bleiben unverschluesselt (Warnung im Log).
BACKUP_PASSPHRASE_FILE=/opt/lumen/deployment/.backup-passphrase
# Optionales Offsite-Ziel fuer rsync (z.B. backup@host:/srv/lumen). Leer = nur lokal.
# Aufbewahrung offsite: fest 30 Tage per Cron AM ZIEL (siehe backup.sh-Kopf).
BACKUP_REMOTE=

# --- Uploads ---
PRESIGNED_URL_EXPIRES_IN=900
MAX_IMAGE_SIZE_BYTES=209715200

# --- CORS / Frontend-Origin ---
CORS_ORIGIN=https://lumen.mr-development.de

# --- SMTP (Keycloak Verify-Email ueber den Projektmailserver) ---
# deploy.sh setzt diese per kcadm in den lumen-Realm (kein Secret im Realm-JSON).
SMTP_HOST=mail.mr-development.de
SMTP_PORT=587
SMTP_FROM=noreply-lumen@mr-development.de
SMTP_FROM_DISPLAY=Lumen
SMTP_USER=noreply-lumen@mr-development.de
SMTP_PASSWORD=bitte-aendern-mailserver-account-passwort
