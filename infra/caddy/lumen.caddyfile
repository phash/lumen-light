# Lumen · light — Block fuer /opt/caddyserver/Caddyfile.
#
# Single-Domain-Topologie (kein Cluster-Shared Keycloak/Garage vorhanden):
#   lumen.mr-development.de
#     /api/*          -> lumen-api:4100      (FastAPI)
#     /auth/*         -> lumen-keycloak:8080 (Keycloak, KC_HTTP_RELATIVE_PATH=/auth)
#     /lumen-images/* -> lumen-minio:9000    (S3, Pre-Signed PUT/GET, same-origin)
#     /*              -> lumen-web:80         (React-SPA via nginx)
#
# Voraussetzung: lumen-api/-web/-keycloak/-minio sind im caddy-proxy-Netz.
# DNS-A-Record lumen.mr-development.de zeigt bereits auf den VPS.

lumen.mr-development.de {
    encode gzip zstd
    # security_headers (HSTS-preload, X-Content-Type-Options, Referrer-Policy,
    # Permissions-Policy, ...) ist global in /opt/caddyserver/Caddyfile
    # definiert. Reviewbare Referenz: infra/caddy/security_headers.snippet.caddy
    # (synchron halten).
    import security_headers

    # API -> FastAPI. JSON-Bodies sind klein (Presets/Edit-State/Feedback),
    # Bild-Pixel laufen ueber /lumen-images -> Body-Limit gegen Memory-DoS.
    @api path /api/*
    handle @api {
        request_body {
            max_size 2MB
        }
        reverse_proxy lumen-api:4100
    }

    # Master-Realm + Admin-Konsolen NICHT ins Internet (Password-Spraying auf
    # den Bootstrap-Admin). Admin-Arbeit per SSH-Tunnel bzw. kcadm im
    # Container (siehe infra/deployment-runbook.md). Die Admin-REST-API des
    # lumen-Realms (/auth/admin/realms/lumen/...) bleibt erreichbar — die
    # API nutzt sie fuer DELETE /me (Service-Account, Bearer-Token).
    @kc_admin path /auth/realms/master /auth/realms/master/* /auth/admin/master/* /auth/admin/realms/master /auth/admin/realms/master/* /auth/admin/*/console /auth/admin/*/console/*
    handle @kc_admin {
        respond "Not found" 404
    }

    # Keycloak unter /auth (eigener Realm-Server). KC setzt eigene Header/CSP
    # fuer seine Login-Seiten — wir ueberschreiben sie hier bewusst NICHT.
    @auth path /auth/*
    handle @auth {
        reverse_proxy lumen-keycloak:8080
    }

    # S3 (MinIO). Pre-Signed PUT/GET laufen same-origin ueber diesen Pfad
    # (kein CORS noetig). Path-Style: erster Pfadteil = Bucket 'lumen-images'.
    # Caddy reicht den Original-Host (lumen.mr-development.de) weiter, daher
    # bleibt die SigV4-Signatur gueltig. Kein request_body-Limit -> grosse
    # Bild-Uploads (bis 200 MB) streamen durch.
    #
    # CVE-2025-31489 (MinIO < RELEASE.2025-04-03): Signatur von Streaming-
    # Uploads mit "unsigned trailer" wird nicht geprueft. Lumen nutzt nur
    # klassische Pre-Signed-PUTs (UNSIGNED-PAYLOAD) -> diese Variante hart
    # blocken. Zusaetzlich: S3-Antworten nie als aktives Dokument ausfuehren
    # (sandbox-CSP + nosniff), falls doch je ein Nicht-Bild im Bucket landet.
    @s3_streaming_trailer {
        path /lumen-images/*
        header_regexp X-Amz-Content-Sha256 (?i)^STREAMING-
    }
    handle @s3_streaming_trailer {
        respond "Forbidden" 403
    }
    @s3 path /lumen-images/*
    handle @s3 {
        header {
            Content-Security-Policy "default-src 'none'; sandbox"
            X-Content-Type-Options "nosniff"
        }
        reverse_proxy lumen-minio:9000
    }

    # Schema-Disclosure hart blocken (Defense-in-Depth zum LUMEN_ENV-Toggle).
    @docs path /docs /docs/* /openapi.json /redoc /redoc/*
    handle @docs {
        respond "Not found" 404
    }

    # SPA (nginx) — strikte CSP NUR fuer die App-Antworten (nicht /auth).
    # script-src erlaubt von musikersuche.org NUR die exakte Datei
    # /matomo/matomo.js (nicht die ganze Origin). 'wasm-unsafe-eval' ist
    # fuer den libraw-wasm-RAW-Decoder noetig (WebAssembly.instantiate) und
    # erlaubt KEIN JS-eval. Kein 'unsafe-inline'/'unsafe-eval' im script-src.
    handle {
        header {
            Content-Security-Policy "default-src 'self'; img-src 'self' blob: data: https://musikersuche.org; media-src 'self' blob:; connect-src 'self' https://musikersuche.org https://tfhub.dev https://storage.googleapis.com https://www.kaggle.com; script-src 'self' 'wasm-unsafe-eval' https://musikersuche.org/matomo/matomo.js; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
        reverse_proxy lumen-web:80
    }
}
